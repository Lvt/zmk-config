#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define LOWER 1
#define RAISE 2

// Media controls

#define VOL_DOWN C_VOLUME_DOWN
#define VOL_UP C_VOLUME_UP
#define VOL_MUTE K_MUTE
#define PREV C_PREVIOUS
#define PLAY C_PLAY_PAUSE
#define NEXT C_NEXT

// Display controls

#define BRIGHT C_BRIGHTNESS_INC
#define DARK C_BRIGHTNESS_DEC

// Window controls

#define APPS C_AC_DESKTOP_SHOW_ALL_WINDOWS
#define SEARCH C_AC_SEARCH

/ {
    behaviors {
        /*
         * htl
         *
         * - tab once to switch layer
         * - hold to enable layer until release
         */

        htl: hold_tab_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAB_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "balanced";
            bindings = <&mo>, <&to>;
        };

        /*
         * hm
         * 
         * - tab once for key press 2nd item
         * - hold for key press 1st item
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // different key press on each press (LSHFT -> CAPS Lock)
        // https://zmk.dev/docs/behaviors/tap-dance
        /*
         * td_caps
         *
         * - tab once for 2nd item
         * - tab twice for 1st item
         */

        td_qm: td_qm {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QM";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&double_q>, <&input_qm>;
        };

        td_lvt: td_lvt {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LVT";
            #binding-cells = <0>;
            bindings = <&kp L>, <&double_l>, <&input_lvt>;
        };

        td_vt: td_vt {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_VT";
            #binding-cells = <0>;
            bindings = <&kp V>, <&double_v>, <&input_vt>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_brace_left {
            timeout-ms = <30>;
            key-positions = <15 16>;
            bindings = <&kp LA(N7)>;
        };

        combo_bracket_left {
            timeout-ms = <30>;
            key-positions = <16 17>;
            bindings = <&kp LA(NUMBER_8)>;
        };

        combo_bracket_right {
            timeout-ms = <30>;
            key-positions = <18 19>;
            bindings = <&kp LA(N9)>;
        };

        combo_brace_right {
            timeout-ms = <30>;
            key-positions = <19 20>;
            bindings = <&kp LA(N0)>;
        };

        combo_pipe {
            timeout-ms = <30>;
            key-positions = <27 28>;
            bindings = <&kp LA(GRAVE)>;
        };

        combo_parenthesis_left {
            timeout-ms = <30>;
            key-positions = <28 29>;
            bindings = <&kp LS(N8)>;
        };

        combo_parenthesis_right {
            timeout-ms = <30>;
            key-positions = <30 31>;
            bindings = <&kp LS(NUMBER_9)>;
        };

        backlash {
            bindings = <&kp LA(MINUS)>;
            key-positions = <31 32>;
        };

        option {
            bindings = <&kp LEFT_ALT>;
            key-positions = <38 37>;
        };

        double_quote {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <6 7>;
        };

        single_quote {
            bindings = <&kp RS(HASH)>;
            key-positions = <5 4>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        input_qm: input_qm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Q) &kp U &kp A &kp R &kp T &kp E &kp T &kp T &kp SPACE &kp M &kp O &kp B &kp I &kp L &kp E>;
            label = "INPUT_QM";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        input_vt: input_vt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp O &kp N &kp SPACE &kp LS(T) &kp I &kp P &kp P &kp E &kp L &kp S &kp K &kp I &kp R &kp C &kp H>;
            label = "INPUT_VT";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        input_lvt: input_lvt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(L) &kp E &kp O &kp N &kp SPACE &kp V &kp PERIOD &kp SPACE &kp LS(T) &kp I &kp P &kp P &kp E &kp L &kp S &kp K &kp I &kp R &kp C &kp H>;
            label = "INPUT_LVT";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        double_l: double_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp L>;
            label = "DOUBLE_L";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        double_v: double_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp V>;
            label = "DOUBLE_V";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        double_q: double_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp Q>;
            label = "DOUBLE_Q";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        move_left: move_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt RCTRL &kt GLOBE &kp LEFT &kt GLOBE &kt RCTRL>;
            label = "MOVE_LEFT";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        move_right: move_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt RCTRL &kt GLOBE &kp RIGHT &kt GLOBE &kt RCTRL>;
            label = "MOVE_RIGHT";
            wait-ms = <10>;
            tap-ms = <10>;
        };
    };

    // cheat-sheet https://peccu.github.io/zmk-cheat-sheet/

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&hm LS(LG(TAB)) LG(TAB)  &td_qm     &kp W        &kp E               &kp R     &kp T        &kp Y      &hm LEFT_BRACKET U  &kp I               &hm SEMICOLON O  &kp P                 &kp BSPC
&kp ESC                  &hm SQT A  &hm MINUS S  &kp D               &kp F     &kp G        &kp H      &kp J               &kp K               &td_lvt          &kp NON_US_BACKSLASH  &kp LA(ENTER)
&kp LSHFT                &kp Z      &kp X        &kp C               &td_vt    &kp B        &kp N      &kp M               &hm RCTRL COMMA     &kp DOT          &kp SLASH             &hm RIGHT_SHIFT MINUS
                                                 &htl LOWER DEFAULT  &kp LCMD  &kp SPACE    &kp ENTER  &kp RIGHT_GUI       &htl RAISE DEFAULT
            >;
        };

        lower_layer {
            bindings = <
&kp TAB         &none      &none  &kp LC(E)           &none     &kp LC(T)    &kp N7        &kp N8        &kp N9              &kp ASTERISK  &none  &kp DEL
&kp ESC         &kp LC(A)  &none  &kp LC(D)           &none     &none        &kp NUMBER_4  &kp N5        &kp NUMBER_6        &kp MINUS     &none  &none
&kp LEFT_SHIFT  &kp LC(Z)  &none  &kp LC(C)           &none     &none        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3        &kp PLUS      &none  &kp RIGHT_SHIFT
                                  &htl LOWER DEFAULT  &kp LCMD  &kp SPACE    &kp ENTER     &kp N0        &htl RAISE DEFAULT
            >;
        };

        raise_layer {
            bindings = <
&kp TAB     &none         &none         &none               &none         &none           &kp C_NEXT         &kp C_PLAY_PAUSE  &kp UP_ARROW      &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&kp ESC     &none         &move_left    &none               &move_right   &bt BT_CLR      &kp C_PREVIOUS     &kp LEFT          &kp DOWN          &kp RIGHT   &kp LG(LC(Q))      &kp LG(LS(NUMBER_4))
&kp LSHIFT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2        &bt BT_SEL 3  &bt BT_SEL 4    &none              &none             &none             &none       &kp GLOBE          &kp RIGHT_SHIFT
                                        &htl LOWER DEFAULT  &kp LCMD      &kp SPACE       &kp RIGHT_CONTROL  &kp DEL           &htl RAISE LOWER
            >;
        };

        tri_layer {
            bindings = <
&kp TAB     &none  &none  &none               &none     &none             &none              &none    &none             &none  &none  &none
&kp ESC     &none  &none  &none               &none     &bt BT_CLR_ALL    &none              &none    &none             &none  &none  &none
&kp LSHIFT  &none  &none  &none               &none     &none             &none              &none    &none             &none  &none  &kp RIGHT_SHIFT
                          &htl LOWER DEFAULT  &kp LCMD  &kp SPACE         &kp RIGHT_CONTROL  &kp DEL  &htl RAISE LOWER
            >;
        };
    };
};
